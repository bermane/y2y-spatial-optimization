# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter / IDE
.ipynb_checkpoints/
.vscode/

# Virtual environment
/.venv

# Data: large third-party rasters + generated aligned outputs (input_data/cleaned_aligned).
# Not for GitHub -- obtain/regenerate locally.
/input_data

# Optimization outputs (03) + figures (04): generated, regenerate locally.
/output_data
/figures

# R: user-global ~/.R/Makevars holds the macOS toolchain fixes (not in-repo).
gurobi.log
.Rhistory
.RData
Rplots.pdf

# Flagship analyses (analyses/<name>/): notebooks, the spec, and the SMALL frozen audit records
# (feature_characterization.csv = the frozen T2; audit_constants.json = constants + layer sha256s)
# are TRACKED -- they are the pre-registration record. Everything generated and regenerable from
# 01_feature_audit.ipynb is not: the bulky curve archive (hash-pinned by audit_constants.json),
# the feature-card PDFs, figures, and -- later -- the per-cell solution matrices (spec s10 runs/).
analyses/*/figures/
analyses/*/audit/feature_cards/
analyses/*/audit/feature_cards_ab/
analyses/*/audit/audit_objects/feature_audit.npz
analyses/*/audit/audit_objects_ab/feature_audit.npz
analyses/*/runs/
# Alberta prioritization acquired layers (analyses/alberta_prioritization/data/): the raw downloads
# (multi-GB: GVI FGDB, ACI GeoTIFF, SRP zips, REST pulls) are NOT tracked -- data/README.md,
# data/acquire.py and data/provenance.json (URL + sha256 per file) are the record; re-acquire locally.
# The small derived extent polygon (data/ab_extent_v1.gpkg) stays tracked.
analyses/*/data/tenure/
analyses/*/data/aoi/
analyses/*/data/pa/
analyses/*/data/derived/

# Tracked on purpose (NOT ignored): config.py, *.ipynb, requirements.txt,
# requirements-R.txt, CLAUDE.md, .claude/settings.json,
# analyses/*/spec/ (study plan + future manifest freeze + sha256),
# analyses/*/audit/audit_objects/{feature_characterization.csv,audit_constants.json},
# archive/ (frozen v1 notebooks; their outputs live in gitignored output_data/),
# configs/ (frozen run configs, e.g. corridors v1 baseline)

# Director package (analyses/y2y/director_package/): the CSV tables + deck outline are tracked (small,
# the record); regenerable rasters, figures, cluster vectors, the draft deck and dev smoke runs are not.
analyses/*/director_package/geotiffs/
analyses/*/director_package/figures/
analyses/*/director_package/*.pptx
analyses/*/director_package/_smoke/
